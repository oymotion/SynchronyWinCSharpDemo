<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SensorSdk.ExampleWinUI3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:SensorSdk.ExampleWinUI3.Controls"
    Title="SensorSDKCXX WinUI3 Demo">

    <Grid ColumnDefinitions="3*,7*" Padding="8">

        <!-- ======================= Left column: IMU ======================= -->
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,3*,2*,Auto,Auto">
            <TextBlock Grid.Row="0" Text="3D Quaternion Visualization"/>
            <ctl:CubeControl Grid.Row="1" x:Name="Cube" Height="200"/>

            <TextBlock Grid.Row="2" Text="2D Waveform + FFT Spectrum (ACC/GYRO/Quat/Euler)"/>
            <ctl:WaveformControl Grid.Row="3" x:Name="Wave2d" MinHeight="120"/>
            <ctl:SpectrumControl Grid.Row="4" x:Name="Spectrum" MinHeight="48"/>

            <Grid Grid.Row="5" ColumnDefinitions="Auto,*,Auto,*" Margin="0,4">
                <TextBlock Grid.Column="0" Text="Display Data Type:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox Grid.Column="1" x:Name="TypeCombo" MinWidth="180" SelectionChanged="OnTypeChanged">
                    <x:String>Acceleration (ACC)</x:String>
                    <x:String>Gyroscope (GYRO)</x:String>
                    <x:String>Quaternion (Quat)</x:String>
                    <x:String>Euler Angle (Euler)</x:String>
                </ComboBox>
                <TextBlock Grid.Column="2" Text="Live Filter:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <ComboBox Grid.Column="3" x:Name="FilterCombo" MinWidth="140" SelectionChanged="OnLiveFilterChanged"/>
            </Grid>

            <Border Grid.Row="6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,4,0,0">
                <StackPanel>
                    <TextBlock Text="Real-time Values" FontWeight="SemiBold"/>
                    <StackPanel x:Name="ValuePanel" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== Right column: device/bio ==================== -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" Margin="8,0,0,0">

            <!-- Device page -->
            <StackPanel Grid.Row="0" Spacing="4">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <CheckBox x:Name="AutoReconnectBox" Content="Auto Reconnect" IsChecked="True"
                                  Click="OnAutoReconnectToggled"/>
                        <TextBlock Text="Discovered Devices:" VerticalAlignment="Center"/>
                        <CheckBox x:Name="CloneDataBox" Content="Clone Data"/>
                        <TextBlock x:Name="SdkLabel" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button x:Name="MultiSyncButton" Content="Multi Start" Click="OnMultiSyncClicked"
                                IsEnabled="False" MinWidth="110"/>
                        <Button x:Name="MultiReplayButton" Content="Multi Replay Bin" Click="OnMultiReplayClicked"
                                MinWidth="110"/>
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <Button x:Name="ScanButton" Content="Start Scan" Click="OnStartScan" MinWidth="110"/>
                        <Button x:Name="StopScanButton" Content="Stop Scan" Click="OnStopScan"
                                IsEnabled="False" MinWidth="110"/>
                        <Button x:Name="ConnectButton" Content="Connect" Click="OnConnectClicked"
                                IsEnabled="False" MinWidth="110"/>
                        <Button x:Name="DisconnectButton" Content="Disconnect" Click="OnDisconnectClicked"
                                IsEnabled="False" MinWidth="110"/>
                    </StackPanel>
                    <ListView Grid.Column="1" x:Name="DeviceList" MaxHeight="110" Margin="8,0"
                              SelectionMode="Single" SelectionChanged="OnDeviceSelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <Button x:Name="ReplayButton" Content="Replay Bin File" Click="OnReplayClicked" MinWidth="110"/>
                        <Button x:Name="AnalyzeButton" Content="Analyze Bin" Click="OnAnalyzeClicked" MinWidth="110"/>
                        <Button x:Name="ReplayPauseButton" Content="Pause Replay" Click="OnReplayPauseResume"
                                IsEnabled="False" MinWidth="110"/>
                        <Button x:Name="ReplayStopButton" Content="Stop Replay" Click="OnReplayStop"
                                IsEnabled="False" MinWidth="110"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="StatusText" Text="Not Connected" TextWrapping="Wrap"/>
                <TextBlock x:Name="RateText" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock x:Name="ModelText" Text="Model: --"/>
                    <TextBlock x:Name="HwText" Text="HW Version: --"/>
                    <TextBlock x:Name="FwText" Text="FW Version: --"/>
                    <TextBlock x:Name="LinkText" Text="Link: --"/>
                    <TextBlock x:Name="MtuText" Text="MTU: --"/>
                    <TextBlock x:Name="PowerText" Text="Power: --%"/>
                </StackPanel>
            </StackPanel>

            <!-- Settings page -->
            <StackPanel Grid.Row="1" Spacing="4">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                    <Border Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="8">
                        <StackPanel>
                            <TextBlock Text="Packet Loss Stats" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LostPacketText" Text="Packet Loss Stats: None" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="8">
                        <StackPanel>
                            <TextBlock Text="Gesture" FontWeight="SemiBold"/>
                            <TextBlock x:Name="GestureText" FontFamily="Consolas" FontSize="11"
                                       Text="Gesture:&#x0A;  gesture: -- (0-8)&#x0A;  raw gesture: -- (0-8)&#x0A;  possiblity: -- (0-100)&#x0A;  strength: -- (0-100)"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid ColumnDefinitions="Auto,*,*,Auto" ColumnSpacing="4">
                    <Border Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="8">
                        <StackPanel>
                            <TextBlock Text="Debug Log" FontWeight="SemiBold"/>
                            <CheckBox x:Name="DebugLogBox" Content="Enable SDK Debug Log" IsChecked="True"
                                      Click="OnDebugLogToggled"/>
                            <CheckBox x:Name="BinDataBox" Content="Enable Debug Bin Data" IsChecked="True"
                                      Click="OnBinDataToggled"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" HorizontalAlignment="Left" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="8">
                        <StackPanel>
                            <TextBlock Text="Data Notification" FontWeight="SemiBold"/>
                            <VariableSizedWrapGrid Orientation="Horizontal" x:Name="NtfPanel"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" HorizontalAlignment="Left" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="8">
                        <StackPanel>
                            <TextBlock Text="Filter" FontWeight="SemiBold"/>
                            <VariableSizedWrapGrid Orientation="Horizontal" x:Name="FilterPanel"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" x:Name="SampleRateSection" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="8">
                        <StackPanel>
                            <TextBlock Text="EEG Sample Rate" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" x:Name="SampleRatePanel" Spacing="8"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Bio page -->
            <Grid Grid.Row="2" RowDefinitions="Auto,Auto,*,*,*,*,*,*,*,*" Margin="0,4,0,0">
                <StackPanel Grid.Row="0" x:Name="PageControls" Orientation="Horizontal"
                            HorizontalAlignment="Center" Visibility="Collapsed">
                    <Button x:Name="PrevPageButton" Content="Prev" Click="OnPrevPage"/>
                    <TextBlock x:Name="PageText" Text="Page 1 / 1" VerticalAlignment="Center"
                               Margin="12,0" MinWidth="80" TextAlignment="Center"/>
                    <Button x:Name="NextPageButton" Content="Next" Click="OnNextPage"/>
                </StackPanel>
                <TextBlock Grid.Row="1" x:Name="BioTitleText" Text="EMG / EEG Waveform"/>
                <ctl:WaveformControl Grid.Row="2" x:Name="BioWave0" MinHeight="60"/>
                <ctl:WaveformControl Grid.Row="3" x:Name="BioWave1" MinHeight="60"/>
                <ctl:WaveformControl Grid.Row="4" x:Name="BioWave2" MinHeight="60"/>
                <ctl:WaveformControl Grid.Row="5" x:Name="BioWave3" MinHeight="60"/>
                <ctl:WaveformControl Grid.Row="6" x:Name="BioWave4" MinHeight="60"/>
                <ctl:WaveformControl Grid.Row="7" x:Name="BioWave5" MinHeight="60"/>
                <ctl:WaveformControl Grid.Row="8" x:Name="BioWave6" MinHeight="60"/>
                <ctl:WaveformControl Grid.Row="9" x:Name="BioWave7" MinHeight="60"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
